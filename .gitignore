# =======================================================================
/node_modules
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/pnpm-debug.log*
package-lock.json

# =======================================================================
# Vite Ruby & Assets Compiled
# =======================================================================
/public/vite
/public/vite-dev
/public/vite-test
/public/assets

# Vite Cache
/.vite
/tmp/cache/vite

